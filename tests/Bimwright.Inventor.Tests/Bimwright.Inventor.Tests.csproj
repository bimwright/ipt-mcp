<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    WS1-B owns src/shared/Infrastructure (IInventorCommand, InventorCommandContext,
    CommandDispatcher) and src/shared/Transport. We glob them into the test assembly so
    the dispatcher/transport get unit-tested in Phase 1 without Inventor. While WS1-B is
    in flight these directories may be empty (the globs then match nothing and the build
    still succeeds). DispatcherTests is gated on HAS_INVENTOR_DISPATCHER, which is defined
    only once CommandDispatcher.cs exists, so the suite compiles + stays green either way.
  -->
  <PropertyGroup Condition="Exists('..\..\src\shared\Infrastructure\CommandDispatcher.cs')">
    <DefineConstants>$(DefineConstants);HAS_INVENTOR_DISPATCHER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\server\Bimwright.Inventor.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\shared\Infrastructure\*.cs" LinkBase="Shared\Infrastructure" />
    <Compile Include="..\..\src\shared\Transport\*.cs" LinkBase="Shared\Transport" />
  </ItemGroup>

</Project>
