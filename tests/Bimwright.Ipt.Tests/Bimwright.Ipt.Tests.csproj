<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    WS1-B owns src/shared/Infrastructure (IInventorCommand, InventorCommandContext,
    CommandDispatcher) and src/shared/Transport. We glob them into the test assembly so
    the dispatcher/transport get unit-tested in Phase 1 without Inventor. While WS1-B is
    in flight these directories may be empty (the globs then match nothing and the build
    still succeeds). DispatcherTests is gated on HAS_INVENTOR_DISPATCHER, which is defined
    only once CommandDispatcher.cs exists, so the suite compiles + stays green either way.
  -->
  <PropertyGroup Condition="Exists('..\..\src\shared\Infrastructure\CommandDispatcher.cs')">
    <DefineConstants>$(DefineConstants);HAS_INVENTOR_DISPATCHER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Same Roslyn as the add-ins, for ScriptReferences (send_code compile references). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\server\Bimwright.Ipt.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\shared\Infrastructure\*.cs" Exclude="..\..\src\shared\Infrastructure\ResponseSpillWriter.cs" LinkBase="Shared\Infrastructure" />
    <Compile Include="..\..\src\shared\Transport\*.cs" LinkBase="Shared\Transport" />
    <Compile Include="..\..\src\shared\Handlers\Export\CaptureImagePolicy.cs" LinkBase="Shared\Handlers\Export" />
    <Compile Include="..\..\src\shared\Handlers\Export\CameraParams.cs" LinkBase="Shared\Handlers\Export" />
    <Compile Include="..\..\src\shared\Handlers\Feature\ExtrudeParams.cs" LinkBase="Shared\Handlers\Feature" />
    <Compile Include="..\..\src\shared\Handlers\Feature\RevolveParams.cs" LinkBase="Shared\Handlers\Feature" />
    <Compile Include="..\..\src\shared\Handlers\Sketch\SketchDimensionParams.cs" LinkBase="Shared\Handlers\Sketch" />
    <Compile Include="..\..\src\shared\Handlers\Sketch\SketchPointInput.cs" LinkBase="Shared\Handlers\Sketch" />
    <Compile Include="..\..\src\shared\Handlers\NumberOrExpression.cs" LinkBase="Shared\Handlers" />
    <Compile Include="..\..\src\shared\Handlers\Core\ReportTaskResultHandler.cs" LinkBase="Shared\Handlers\Core" />
    <Compile Include="..\..\src\shared\Handlers\BatchExecutor.cs" LinkBase="Shared\Handlers" />
    <Compile Include="..\..\src\shared\Handlers\Parameters\ExcelParameterSource.cs" LinkBase="Shared\Handlers\Parameters" />
    <Compile Include="..\..\src\shared\Handlers\IPart\IPartInput.cs" LinkBase="Shared\Handlers\IPart" />
    <Compile Include="..\..\src\shared\Handlers\IPart\IPartExcelCatalog.cs" LinkBase="Shared\Handlers\IPart" />
    <Compile Include="..\..\src\shared\Handlers\SheetFabrication\SheetFabricationThicknessRecovery.cs" LinkBase="Shared\Handlers\SheetFabrication" />
    <Compile Include="..\..\src\shared\Handlers\ILogic\ILogicOutcome.cs" LinkBase="Shared\Handlers\ILogic" />
    <Compile Include="..\..\src\shared\Handlers\ILogic\ILogicResultChannel.cs" LinkBase="Shared\Handlers\ILogic" />
    <Compile Include="..\..\src\shared\Handlers\ILogic\ILogicLogReader.cs" LinkBase="Shared\Handlers\ILogic" />
    <Compile Include="..\..\src\shared\Handlers\HandlerBase.cs" LinkBase="Shared\Handlers" />
    <Compile Include="..\..\src\shared\Handlers\Drawing\DrawingCommandHandler.cs" LinkBase="Shared\Handlers\Drawing" />
    <Compile Include="..\..\src\shared\Handlers\Assembly\CreateDesignViewHandler.cs" LinkBase="Shared\Handlers\Assembly" />
    <Compile Include="..\..\src\shared\Handlers\Vec3Params.cs" LinkBase="Shared\Handlers" />
    <Compile Include="..\..\src\shared\Handlers\EnumText.cs" LinkBase="Shared\Handlers" />
    <Compile Include="..\..\src\shared\Handlers\Code\ScriptReferences.cs" LinkBase="Shared\Handlers\Code" />
    <Compile Include="..\..\src\shared\Handlers\Code\McpTaskResult.cs" LinkBase="Shared\Handlers\Code" />
    <Compile Include="..\..\src\shared\Handlers\Code\SendCodeTask.cs" LinkBase="Shared\Handlers\Code" />
    <Compile Include="..\..\src\shared\Handlers\Code\IptGuard.cs" LinkBase="Shared\Handlers\Code" />
    <Compile Include="..\..\src\shared\Handlers\Code\ScriptLoopGuard.cs" LinkBase="Shared\Handlers\Code" />
    <Compile Include="..\..\src\shared\Handlers\Code\SendCodeHelpers.cs" LinkBase="Shared\Handlers\Code" />
    <Compile Include="..\..\src\shared\Logging\*.cs" Exclude="..\..\src\shared\Logging\BoundedLogFile.cs" LinkBase="Shared\Logging" />
    <Compile Include="..\..\src\shared\Update\UpdateCheck.cs" Link="Shared\Update\UpdateCheck.cs" />
    <!-- Host-free toast model: the card state machine, content builder, layout, config and status text.
         The WPF card itself is covered by tests/Bimwright.Ipt.Toast.Tests. -->
    <Compile Include="..\..\src\shared\Views\Toast\Model\*.cs" LinkBase="Shared\Views\Toast\Model" />
    <Compile Include="..\..\src\shared\Localization\L.cs" Link="Shared\Localization\L.cs" />
  </ItemGroup>

</Project>
