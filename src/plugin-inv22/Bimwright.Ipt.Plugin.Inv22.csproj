<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>Bimwright.Ipt.Plugin</RootNamespace>
    <AssemblyName>Bimwright.Ipt.Plugin.Inv22</AssemblyName>
    <Version>0.2.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <InventorYear>2022</InventorYear>
    <DefineConstants>$(DefineConstants);INVENTOR2022</DefineConstants>
    <InventorInteropDir Condition="'$(InventorInteropDir)' == ''">C:\Program Files\Common Files\Autodesk Shared\Extensions 2022\Framework\Interop</InventorInteropDir>
  </PropertyGroup>

  <Target Name="ValidateInventorReferences" BeforeTargets="ResolveReferences" Condition="'$(SkipInventorReferenceCheck)' != 'true'">
    <Error Condition="!Exists('$(InventorInteropDir)\Autodesk.Inventor.Interop.dll')"
           Text="Inventor interop not found at $(InventorInteropDir). Pass /p:InventorInteropDir=... or /p:SkipInventorReferenceCheck=true for project-shape checks." />
  </Target>

  <ItemGroup>
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorInteropDir)\Autodesk.Inventor.Interop.dll</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\**\*.cs" LinkBase="Shared" />
    <EmbeddedResource Include="..\shared\Contracts\send-code-hints.json" LogicalName="Bimwright.Ipt.SendCodeHints.json" />
  </ItemGroup>

</Project>
