<?xml version="1.0" encoding="utf-8"?>
<!--
  Registry-free Inventor add-in manifest for Inventor 2027 (net10.0-windows7.0, Named Pipe).
  ClassId/ClientId MUST equal the [Guid] on InventorAddInServer (see plugin-inv27/InventorAddInServer.cs).

  Version filter: Inventor's internal major version = calendar year - 1996.
    2022 = 26, 2023 = 27, 2024 = 28, 2025 = 29, 2026 = 30, 2027 = 31.
  To isolate exactly major version M, bracket GreaterThan (M-1).. and LessThan (M+1).. (strict
  bounds; the ".." is the minor/service-pack wildcard). For 2027 (M=31): 30.. < v < 32.. selects 31.
  FLAG (Phase-4 on real Inventor): the Inventor 2027 interop on the build machine is a STUB reporting
  assembly version 29.0.0.0 (not 31). 2027 = 31 is therefore DERIVED from the year-1996 rule, not
  observed from the interop. Confirm 31 against a real Inventor 2027 About box / SDK before shipping.
-->
<Addin Type="Standard">
  <!-- ClassId/ClientId MUST match the [Guid] on InventorAddInServer (plugin-inv27). -->
  <ClassId>{B1D27027-0000-4A27-9B27-BF1E2027C0DE}</ClassId>
  <ClientId>{B1D27027-0000-4A27-9B27-BF1E2027C0DE}</ClientId>
  <DisplayName>Bimwright Inventor MCP (2027)</DisplayName>
  <Description>Bimwright inventor-mcp gateway add-in for Autodesk Inventor 2027.</Description>
  <Assembly>Bimwright.Inventor.Plugin.Inv27.dll</Assembly>
  <LoadOnStartUp>1</LoadOnStartUp>
  <LoadAutomatically>1</LoadAutomatically>
  <UserUnloadable>1</UserUnloadable>
  <Hidden>0</Hidden>
  <SupportedSoftwareVersionGreaterThan>30..</SupportedSoftwareVersionGreaterThan>
  <SupportedSoftwareVersionLessThan>32..</SupportedSoftwareVersionLessThan>
  <!-- 2027 is the version where this is honoured: isolated dependency loading context. 0 = isolated. -->
  <UseInventorAssemblyContext>0</UseInventorAssemblyContext>
</Addin>
