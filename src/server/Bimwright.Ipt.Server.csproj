<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Bimwright.Ipt.Server</RootNamespace>
    <AssemblyName>Bimwright.Ipt.Server</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>bimwright-ipt</ToolCommandName>
    <PackageId>Bimwright.Ipt.Server</PackageId>
    <Version>2.5.1</Version>
    <Authors>Khoa Le</Authors>
    <Description>MCP gateway for Autodesk Inventor 2022-2027</Description>
    <PackageProjectUrl>https://github.com/bimwright/ipt-mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bimwright/ipt-mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>mcp;inventor;cad;ipt;iam;ai</PackageTags>
    <Copyright>Copyright 2026 Khoa Le</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Bimwright.Ipt.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\Contracts\*.cs" LinkBase="Shared\Contracts" />
    <Compile Include="..\shared\Security\*.cs" LinkBase="Shared\Security" />
    <Compile Include="..\shared\ToolBaker\*.cs" LinkBase="Shared\ToolBaker" />
    <Compile Include="..\shared\Setup\*.cs" LinkBase="Shared\Setup" />
    <Compile Include="..\shared\Logging\BoundedLogFile.cs" Link="Shared\Logging\BoundedLogFile.cs" />
    <Compile Include="..\shared\Logging\LogRetentionPolicy.cs" Link="Shared\Logging\LogRetentionPolicy.cs" />
    <Compile Include="..\shared\Infrastructure\ResponseSpillWriter.cs" Link="Shared\Infrastructure\ResponseSpillWriter.cs" />
    <EmbeddedResource Include="..\shared\Contracts\send-code-hints.json" LogicalName="Bimwright.Ipt.SendCodeHints.json" />
    <EmbeddedResource Include="..\shared\Contracts\send-code-routing.json" LogicalName="Bimwright.Ipt.SendCodeRouting.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.4.2" />
    <!-- 10.x matches the Microsoft.Extensions.* abstractions that ModelContextProtocol 1.4 pulls in. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.34" />
    <!-- Pin patched native SQLite without changing managed assembly bindings. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
