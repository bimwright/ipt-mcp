<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Bimwright.Inventor.Server</RootNamespace>
    <AssemblyName>Bimwright.Inventor.Server</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>bimwright-inventor</ToolCommandName>
    <PackageId>Bimwright.Inventor.Server</PackageId>
    <Version>0.1.0-dev</Version>
    <Authors>Khoa Le</Authors>
    <Description>MCP gateway for Autodesk Inventor 2022-2027</Description>
    <PackageProjectUrl>https://github.com/bimwright/inventor-mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bimwright/inventor-mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>mcp;inventor;cad;ipt;iam;ai</PackageTags>
    <Copyright>Copyright 2026 Khoa Le</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bimwright.Inventor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\Contracts\*.cs" LinkBase="Shared\Contracts" />
    <Compile Include="..\shared\Security\*.cs" LinkBase="Shared\Security" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.1.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
