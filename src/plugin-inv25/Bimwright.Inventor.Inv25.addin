<?xml version="1.0" encoding="utf-8"?>
<Addin Type="Standard">
  <!-- ClassId/ClientId MUST match the [Guid] on InventorAddInServer (plugin-inv25). -->
  <ClassId>{B1D25025-0000-4A25-9B25-BF1E2025C0DE}</ClassId>
  <ClientId>{B1D25025-0000-4A25-9B25-BF1E2025C0DE}</ClientId>
  <DisplayName>Bimwright Inventor MCP (2025)</DisplayName>
  <Description>Bimwright inventor-mcp gateway add-in for Autodesk Inventor 2025.</Description>
  <Assembly>Bimwright.Inventor.Plugin.Inv25.dll</Assembly>
  <LoadOnStartUp>1</LoadOnStartUp>
  <LoadAutomatically>1</LoadAutomatically>
  <UserUnloadable>1</UserUnloadable>
  <Hidden>0</Hidden>
  <SupportedSoftwareVersionGreaterThan>29..</SupportedSoftwareVersionGreaterThan>
  <SupportedSoftwareVersionLessThan>30..</SupportedSoftwareVersionLessThan>
  <!-- Harmless on 2025; honoured (isolated dependency loading) on 2027. 0 = isolated context. -->
