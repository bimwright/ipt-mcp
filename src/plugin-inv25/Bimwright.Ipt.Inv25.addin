<?xml version="1.0" encoding="utf-8"?>
<!--
  Registry-free Inventor add-in manifest for Inventor 2025 (net8.0-windows7.0, Named Pipe).
  ClassId/ClientId MUST equal the [Guid] on InventorAddInServer (see plugin-inv25/InventorAddInServer.cs).

  Version filter: Inventor's internal major version = calendar year - 1996.
    2022 = 26, 2023 = 27, 2024 = 28, 2025 = 29, 2026 = 30, 2027 = 31.
  To isolate exactly major version M, bracket GreaterThan (M-1).. and LessThan (M+1).. (strict
  bounds; the ".." is the minor/service-pack wildcard). For 2025 (M=29): 28.. < v < 30.. selects 29.
  VERIFIED: the installed Autodesk.Inventor.Interop for 2025 reports assembly version 29.0.0.0.
-->
<Addin Type="Standard">
  <!-- ClassId/ClientId MUST match the [Guid] on InventorAddInServer (plugin-inv25). -->
  <ClassId>{B1D25025-0000-4A25-9B25-BF1E2025C0DE}</ClassId>
  <ClientId>{B1D25025-0000-4A25-9B25-BF1E2025C0DE}</ClientId>
  <DisplayName>Bimwright Inventor MCP (2025)</DisplayName>
  <Description>Bimwright ipt-mcp gateway add-in for Autodesk Inventor 2025.</Description>
  <Assembly>Bimwright.Ipt.Plugin.Inv25.dll</Assembly>
  <LoadOnStartUp>1</LoadOnStartUp>
  <LoadAutomatically>1</LoadAutomatically>
  <UserUnloadable>1</UserUnloadable>
  <Hidden>0</Hidden>
  <SupportedSoftwareVersionGreaterThan>28..</SupportedSoftwareVersionGreaterThan>
  <SupportedSoftwareVersionLessThan>30..</SupportedSoftwareVersionLessThan>
  <!-- Harmless on 2025; honoured (isolated dependency loading) on 2027. 0 = isolated context. -->
  <UseInventorAssemblyContext>0</UseInventorAssemblyContext>
</Addin>
